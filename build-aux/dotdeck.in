#!@PYTHON@
"""Dotdeck launcher."""

import os
import sys

# Prefer the package installed next to this script (<prefix>/share/dotdeck), so
# relocated trees such as the snap work; fall back to the configured prefix.
_relative = os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                          os.pardir, "share", "dotdeck"))
sys.path.insert(1, _relative if os.path.isdir(os.path.join(_relative, "dotdeck"))
                else "@PKGDATADIR@")

from dotdeck.main import main  # noqa: E402

sys.exit(main())
